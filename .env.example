# Atlassian / Jira Cloud — copy to .env and fill in. .env is gitignored.
# Auth is Basic: base64("<email>:<token>"). The token alone is not enough.

# Your Atlassian Cloud API token (https://id.atlassian.com/manage-profile/security/api-tokens)
ATLASSIAN_API_KEY=

# The email address that owns the API token above
ATLASSIAN_EMAIL=

# Your Atlassian site base URL, no trailing slash (e.g. https://acme.atlassian.net)
ATLASSIAN_SITE_URL=

# Default Jira project key for TAT work (the prefix on issue IDs, e.g. TAT)
JIRA_PROJECT_KEY=
